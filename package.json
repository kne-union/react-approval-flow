{
  "name": "@kne/react-approval-flow",
  "version": "0.1.0",
  "description": "审批流程设计器：树形流程图编辑审批、办理、抄送、条件分支、并行分支节点，节点内嵌 form-creator 补充表单，基于流程上下文编辑分支条件，并提供流程校验、上下文 Schema 推导与运行状态预览",
  "syntax": {
    "esmodules": true
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.js",
  "scripts": {
    "init": "husky && npm run init-example && npx @kne/npm-tools deployPrompts frontend-libs",
    "start": "run-p start:lib start:md start:example",
    "build": "run-s build:lib build:md build:example",
    "init-example": "modules-dev-libs-init",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "build:locale": "microbundle src/locale/*.js -o dist/locale --no-compress --format modern,cjs ",
    "build:lib-main": "microbundle --no-compress --format modern,cjs --jsxImportSource react --jsx React.createElement --jsxFragment React.Fragment",
    "build:lib": "run-s build:locale build:lib-main",
    "start:lib": "microbundle watch --no-compress --format modern,cjs --jsxImportSource react --jsx React.createElement --jsxFragment React.Fragment",
    "build:example": "cd example && npm run build",
    "start:example": "cd example && npm run start",
    "test": "node --import ./test/resolve-hook.mjs --test test/*.test.mjs",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "cross-env CI=1 react-scripts test --env=jsdom",
    "test:watch": "react-scripts test --env=jsdom",
    "prettier": "prettier --config .prettierrc --write '{src/**/*,index,prompts}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/react-approval-flow.git"
  },
  "keywords": [
    "approval",
    "workflow",
    "flow-designer",
    "审批流",
    "流程设计器",
    "条件分支",
    "并行分支",
    "form-creator",
    "react"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/react-approval-flow/issues"
  },
  "homepage": "https://www.kne-union.top/#/libs/ReactApprovalFlow",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "peerDependencies": {
    "@kne/form-info": ">=0.1.30",
    "@kne/info-page": ">=0.2.19",
    "@kne/react-form-antd": ">=4.1.14",
    "@kne/remote-loader": ">=1.4.0",
    "antd": ">=6",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@kne/form-info": "^0.1.30",
    "@kne/info-page": "^0.2.19",
    "@kne/microbundle": "^0.15.5",
    "@kne/modules-dev": "^2.4.20",
    "@kne/react-form-antd": "^4.1.14",
    "@kne/remote-loader": "^1.4.6",
    "antd": "^6.6.4",
    "cross-env": "^7.0.3",
    "husky": "^9.0.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@kne/form-creator": "^0.1.28",
    "@kne/react-flow-chart": "^0.2.0",
    "@kne/react-intl": "^0.1.10",
    "@kne/responsive-utils": "^0.1.16",
    "classnames": "^2.5.1"
  }
}
